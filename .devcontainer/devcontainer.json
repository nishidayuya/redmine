{
  "name": "Redmine Dev Container",
  // The services, and why none of them publishes a port to the host, are
  // described in docker-compose.yml.
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/redmine",
  "runServices": [
    "app",
    "web",
    "sidekiq",
    "postgres",
    "mysql",
    "redis",
    "mailpit"
  ],
  "shutdownAction": "stopCompose",
  "features": {
    // Pinned to 4 rather than 2: from 3.x on the feature picks the iptables
    // backend when the container starts instead of when the image is built, so
    // it lands on nft on a host whose kernel no longer carries the legacy
    // ip_tables module. Ubuntu 26.04, which the arm64 CI leg runs on, is such a
    // host, and post_start_command.d/00-firewall needs iptables-restore to work
    // there.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": false
    }
  },
  "mounts": [
    "source=${localEnv:DOT_DEVCONTAINER_HOME},target=/dev_container_home,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DOT_DEVCONTAINER_HOME": "/dev_container_home"
  },
  "capAdd": [
    "NET_ADMIN"
  ],
  "initializeCommand": ".devcontainer/run-parts.sh .devcontainer/initialize_command.d",
  // runArgs does not apply to a Docker Compose service, so "--init",
  // "--add-host" and "--env-file" are set in docker-compose.yml instead.
  "overrideCommand": true,
  "postCreateCommand": ".devcontainer/run-parts.sh .devcontainer/post_create_command.d",
  "postStartCommand": ".devcontainer/run-parts.sh .devcontainer/post_start_command.d",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "shopify.ruby-lsp",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
