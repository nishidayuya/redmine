#!/bin/sh

set -eux

# Test repositories for the SCM tests of every SCM Redmine supports: Subversion,
# CVS, Bazaar, Mercurial, Git (with and without non-ASCII paths) and the
# filesystem. This is what "ci:setup" does too.
RAILS_ENV=test bundle exec rake test:scm:setup:all

# Re-extracts a repository whose fixture is newer than the extracted copy.
RAILS_ENV=test bundle exec rake test:scm:update
