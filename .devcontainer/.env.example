# Versions used by docker-compose.yml and Dockerfile.
#
# initialize_command.d/20-env copies this file to .devcontainer/.env when that
# file is missing, so editing .env is enough to try another version. .env is
# ignored by git; keep this example in sync when you bump a default.

# Installed with mise (https://mise.jdx.dev/). Redmine's Gemfile requires
# ">= 3.3.0, < 4.1.0".
RUBY_VERSION=4.0.9

# https://hub.docker.com/_/postgres -> postgres:${POSTGRES_VERSION}-alpine
# The RDBMS that config/database.yml points at.
POSTGRES_VERSION=18.6

# https://hub.docker.com/_/mysql -> mysql:${MYSQL_VERSION}
# An alternative RDBMS. Its configuration is commented out in
# config/database.yml.
MYSQL_VERSION=8.4.13

# https://hub.docker.com/_/redis -> redis:${REDIS_VERSION}-alpine
# The queue of Sidekiq.
REDIS_VERSION=8.10.2

# https://hub.docker.com/r/axllent/mailpit -> axllent/mailpit:v${MAILPIT_VERSION}
# The SMTP server that Redmine delivers to, see config/configuration.yml.
MAILPIT_VERSION=1.32.0
