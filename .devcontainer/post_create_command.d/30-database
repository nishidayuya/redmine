#!/bin/sh

set -eux

# The "postgres" service is usually still starting up when this runs.
until pg_isready --host "${REDMINE_POSTGRES_HOST}" --username "${REDMINE_POSTGRES_USER}" --quiet
do
  echo "waiting for PostgreSQL at ${REDMINE_POSTGRES_HOST}..." >&2
  sleep 1
done

# Creates both the development and the test database, skipping one that
# exists already.
bundle exec rake db:create

bundle exec rake db:migrate

# db/schema.rb is ignored by git, and the test suite loads it into the test
# database. This is what the "ci:setup" task does too.
bundle exec rake db:schema:dump

# Trackers, roles, statuses and so on. The task refuses to run on a database
# that holds data already, so only run it while the instance is still empty.
if test "$(bundle exec rails runner 'print Tracker.count')" -eq 0
then
  REDMINE_LANG=en bundle exec rake redmine:load_default_data

  # Git and Subversion are the SCMs that the repository form offers. The
  # clients of Bazaar, CVS and Mercurial are installed for their tests too, so
  # enable them in Administration > Settings > Repositories when you need them.
  bundle exec rails runner 'Setting.enabled_scm = %w[Subversion Git]'
fi
